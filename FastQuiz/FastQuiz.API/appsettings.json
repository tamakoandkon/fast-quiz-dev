{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Default": {
      "Type": "sqlite",
      "ConnectionString": "Data Source=data/fastquiz.db;Cache=Shared"
    }
  },
  "Auth": {
    "ConnectionString": "Data Source=data/auth.db;Cache=Shared",
    "Type": "sqlite"
  },
  "Question": {
    "ConnectionString": "Data Source=data/question.db;Cache=Shared",
    "Type": "sqlite"
  },
  "Quiz": {
    "ConnectionString": "Data Source=data/quiz.db;Cache=Shared",
    "Type": "sqlite"
  },
  "Jwt": {
    "Issuer": "fqz.domian.com",
    "Audience": "domain.com"
  },
  "Hangfire": {
    "ConnectionString": "data/hangfire.db",
    "Type": "sqlite"
  },
  "BootstrapAdmin": {
    "Enabled": false
  },
  "Migrations": {
    "RunMigrationsOnly": false,
    "RunMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://yourdomain.com",
      "https://www.yourdomain.com",
      "https://api.yourdomain.com",
      "http://localhost:3000"
    ]
  },
  "AllowedHosts": "*"
}
