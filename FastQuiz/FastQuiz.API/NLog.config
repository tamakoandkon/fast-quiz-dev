<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Off"
      internalLogFile="${basedir}/logs/internal-nlog.log">

  <variable name="logDir" value="${basedir}/logs" />
  <variable name="dateDir" value="${date:format=yyyy-MM-dd}" />
  <!-- 时间戳固定为 2026-09-16 07:48:59.123 格式（本地时间，写死避免 other 区域设置下的格式漂移） -->
  <variable name="stamp" value="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}" />
  <variable name="layout" value="${stamp}|${level:uppercase=true:padding=-5}|${threadid:padding=3}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />

  <targets>
    <!-- 常规运行日志：按日期文件夹存放 -->
    <target xsi:type="File"
            name="allFile"
            fileName="${logDir}/${dateDir}/all.log"
            layout="${layout}"
            encoding="utf-8"
            keepFileOpen="true"
            archiveAboveSize="20971520"
            maxArchiveFiles="10" />

    <!-- 系统/宿主框架日志 -->
    <target xsi:type="File"
            name="systemFile"
            fileName="${logDir}/${dateDir}/system.log"
            layout="${layout}"
            encoding="utf-8"
            keepFileOpen="true"
            archiveAboveSize="20971520"
            maxArchiveFiles="10" />

    <!-- 业务日志：FastQuiz.Auth -->
    <target xsi:type="File"
            name="authFile"
            fileName="${logDir}/${dateDir}/auth.log"
            layout="${layout}"
            encoding="utf-8"
            keepFileOpen="true"
            archiveAboveSize="20971520"
            maxArchiveFiles="10" />

    <!-- 业务日志：FastQuiz.Question -->
    <target xsi:type="File"
            name="questionFile"
            fileName="${logDir}/${dateDir}/question.log"
            layout="${layout}"
            encoding="utf-8"
            keepFileOpen="true"
            archiveAboveSize="20971520"
            maxArchiveFiles="10" />

    <!-- 业务日志：FastQuiz.Quiz -->
    <target xsi:type="File"
            name="quizFile"
            fileName="${logDir}/${dateDir}/quiz.log"
            layout="${layout}"
            encoding="utf-8"
            keepFileOpen="true"
            archiveAboveSize="20971520"
            maxArchiveFiles="10" />

    <!-- 业务日志：FastQuiz.API -->
    <target xsi:type="File"
            name="apiFile"
            fileName="${logDir}/${dateDir}/api.log"
            layout="${layout}"
            encoding="utf-8"
            keepFileOpen="true"
            archiveAboveSize="20971520"
            maxArchiveFiles="10" />

    <!-- 错误日志：只收 Warning 及以上 -->
    <target xsi:type="File"
            name="errorFile"
            fileName="${logDir}/${dateDir}/error.log"
            layout="${layout}"
            encoding="utf-8"
            keepFileOpen="true"
            archiveAboveSize="20971520"
            maxArchiveFiles="30" />

    <!-- 控制台：与文件同一套 layout（含时间戳 + 级别），仅给级别片段着色，其余默认色 -->
    <target xsi:type="ColoredConsole"
            name="console"
            layout="${layout}"
            useDefaultRowHighlightingRules="false">
      <!-- highlight-word：只给行内的级别字段上色（padding=-5 已把级别补成 5 字符宽） -->
      <highlight-word condition="level == LogLevel.Trace" foregroundColor="DarkGray" text="TRACE" />
      <highlight-word condition="level == LogLevel.Debug" foregroundColor="Gray" text="DEBUG" />
      <highlight-word condition="level == LogLevel.Info" foregroundColor="Green" text="INFO " />
      <highlight-word condition="level == LogLevel.Warn" foregroundColor="Yellow" text="WARN " />
      <highlight-word condition="level == LogLevel.Error" foregroundColor="Red" text="ERROR" />
      <highlight-word condition="level == LogLevel.Fatal" foregroundColor="White" backgroundColor="DarkRed" text="FATAL" />
    </target>
  </targets>

  <!--
    规则从上往下匹配，final="true" 表示该条命中后不再继续往下匹配。
    因此：
      - 不 final 的规则（allFile、console、errorFile）放在最上面，保证它们拿到全部日志；
      - 带 final 的规则只负责「文件分流」，放在后面，不影响控制台。
  -->
  <rules>
	<!-- 压测期间临时关闭所有日志：任何日志到此终止，不再往下走 -->
  <!--   <logger name="*" minlevel="Trace" final="true" /> -->
	  
    <!-- 1) 全量日志进 all.log（不 final，继续往下） -->
    <logger name="*" minlevel="Trace" writeTo="allFile" />

    <!-- 2) 控制台：Info 起，与文件日志共存（不 final，继续往下） -->
    <logger name="*" minlevel="Info" writeTo="console" />

    <!-- 3) 错误日志：Warning 及以上（不 final，继续往下） -->
    <logger name="*" minlevel="Warn" writeTo="errorFile" />

    <!-- 4) 以下仅做文件分流，final 只影响后续的文件规则，控制台已在上面收到日志 -->
    <logger name="Microsoft.*" minlevel="Info" writeTo="systemFile" final="true" />
    <logger name="System.*" minlevel="Info" writeTo="systemFile" final="true" />
    <logger name="Hangfire.*" minlevel="Info" writeTo="systemFile" final="true" />

    <logger name="FastQuiz.Auth.*" minlevel="Info" writeTo="authFile" final="true" />
    <logger name="FastQuiz.Question.*" minlevel="Info" writeTo="questionFile" final="true" />
    <logger name="FastQuiz.Quiz.*" minlevel="Info" writeTo="quizFile" final="true" />
    <logger name="FastQuiz.API.*" minlevel="Info" writeTo="apiFile" final="true" />
  </rules>
</nlog>
