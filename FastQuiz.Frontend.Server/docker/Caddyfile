:80 {
    root * /usr/share/caddy
    encode zstd gzip

    # Strip /api before forwarding, keeping API errors out of the SPA fallback.
    handle_path /api/* {
        reverse_proxy fqz-core:8080
    }
    handle /health {
        reverse_proxy fqz-core:8080
    }
    handle {
        @static path /_nuxt/*
        header @static Cache-Control "public, max-age=31536000, immutable"
        @config path /config.json
        header @config Cache-Control "no-store"
        try_files {path} /index.html
        file_server
    }
}
